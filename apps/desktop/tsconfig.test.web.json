{
  "extends": "./tsconfig.web.json",
  "include": [
    "../../tests/desktop/renderer.test.ts",
    "../../tests/desktop/renderer/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
