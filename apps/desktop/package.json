{
  "name": "ayaka-desktop",
  "version": "0.1.22",
  "description": "Ayaka 是一个本地优先的 AI 桌面工作台",
  "homepage": "https://ai.zzzvoid.com/",
  "author": "Bess Croft",
  "main": "./out/main/index.mjs",
  "scripts": {
    "format": "prettier --write . ../../tests/desktop",
    "lint": "eslint --cache --rule \"prettier/prettier: off\" . && pnpm --dir ../.. exec node apps/desktop/node_modules/eslint/bin/eslint.js --cache --config eslint.config.mjs tests/desktop",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:test:web": "tsc --noEmit -p tsconfig.test.web.json --composite false",
    "typecheck:test:node": "tsc --noEmit -p tsconfig.test.node.json --composite false",
    "typecheck:test": "npm run typecheck:test:web && npm run typecheck:test:node",
    "start": "electron-vite preview",
    "rebuild:native": "node scripts/rebuild-better-sqlite3.cjs",
    "setup": "pnpm install && pnpm run rebuild:native",
    "dev": "pnpm run rebuild:native && electron-vite dev",
    "build": "pnpm run rebuild:native && npm run typecheck && electron-vite build",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "postinstall": "node scripts/rebuild-better-sqlite3.cjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "pnpm run rebuild:native && electron-vite build && electron-builder --mac",
    "build:linux": "pnpm run rebuild:native && electron-vite build && electron-builder --linux",
    "test": "npm run test:renderer && npm run test:main && npm run test:electron",
    "test:renderer": "node scripts/run-desktop-tests.mjs renderer",
    "test:main": "node scripts/run-desktop-tests.mjs main",
    "test:electron": "node scripts/run-desktop-tests.mjs electron"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "catalog:",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hono/node-server": "^1.13.7",
    "@openai/agents": "catalog:",
    "@openai/agents-extensions": "catalog:",
    "@radix-ui/react-use-controllable-state": "catalog:",
    "@streamdown/cjk": "catalog:",
    "@streamdown/code": "catalog:",
    "@streamdown/math": "catalog:",
    "@streamdown/mermaid": "catalog:",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "cheerio": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "croner": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.2",
    "hono": "^4.6.12",
    "lucide-react": "catalog:",
    "mem0ai": "catalog:",
    "motion": "catalog:",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "catalog:",
    "electron": "catalog:",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-day-picker": "catalog:",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  }
}
